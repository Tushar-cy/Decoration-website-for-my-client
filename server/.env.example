NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/decorjoy
# Minimum 32 character random secrets
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_refresh_secret
# Comma-separated CORS allowed origins
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379

# Initial Admin Seeding (Password must be at least 12 chars, cannot be admin123)
ADMIN_EMAIL=admin@decorjoy.com
ADMIN_PASSWORD=DecorJoyAdmin2026!

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
