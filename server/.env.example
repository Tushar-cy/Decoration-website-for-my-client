NODE_ENV=development
PORT=5000

# -------------------------------------------------------------
# DATABASE CONNECTION (REQUIRED)
# Option A (MongoDB Atlas Free Cloud - RECOMMENDED):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/decorjoy?retryWrites=true&w=majority
# Option B (Local MongoDB if installed):
# MONGO_URI=mongodb://127.0.0.1:27017/decorjoy
# -------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/decorjoy

# Minimum 32 character random secrets
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_refresh_secret
# Comma-separated CORS allowed origins
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379

# Initial Admin Seeding (Password must be at least 12 chars, cannot be admin123)
ADMIN_EMAIL=admin@decorjoy.com
ADMIN_PASSWORD=DecorJoyAdmin2026!

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Observability — Sentry (optional, but strongly recommended in production)
SENTRY_DSN=
SENTRY_RELEASE=             # Set by CI: git rev-parse --short HEAD

# WhatsApp Business Cloud API (optional — enables instant owner notifications)
# Get these from: https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=   # e.g. 123456789012345
WHATSAPP_ACCESS_TOKEN=      # Permanent system user token (never expires)
OWNER_WHATSAPP=             # Owner's number without + e.g. 917015767715
